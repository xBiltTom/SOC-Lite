# =====================================================================
#  SOC-Lite · configuración de ejemplo
#  Copiar a .env y cambiar TODOS los secretos antes de desplegar.
# =====================================================================

# Puertos host del stack: 8090 web · 8010 API/docs · 8011 triaje
#                        5439 PostgreSQL · 5679 n8n
# (los puertos internos de los contenedores no cambian)

# --- Aplicación -------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=cambiar-por-una-clave-de-al-menos-64-caracteres-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=10
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# --- PostgreSQL -------------------------------------------------------
POSTGRES_USER=soclite
POSTGRES_PASSWORD=soclite
POSTGRES_DB=soclite
DATABASE_URL=postgresql+asyncpg://soclite:soclite@db:5432/soclite
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Ingesta / automatización ----------------------------------------
INGEST_API_KEY=dev-ingest-key-change-me
DEDUP_WINDOW_MINUTES=15
SOCLITE_API_URL=http://backend:8000
SOCLITE_INGEST_KEY=dev-ingest-key-change-me

# --- Servicio de triaje (LangChain) -----------------------------------
TRIAGE_SERVICE_URL=http://triage:8001
TRIAGE_TIMEOUT_SECONDS=75
TRIAGE_FAIL_OPEN=true
LANGCHAIN_URL=http://triage:8001

# --- LLM remoto compatible con OpenAI (opcional) -----------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_ENABLED=true
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOOL_ROUNDS=4

# --- Threat intelligence (opcional; sin clave se omite el proveedor) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GEOIP_ENABLED=true
THREAT_INTEL_TIMEOUT_SECONDS=6

# --- Notificaciones y ticketing ---------------------------------------
SLACK_WEBHOOK_URL=
OSTICKET_URL=
OSTICKET_TOKEN=

# --- n8n --------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
GENERIC_TIMEZONE=America/Lima

# --- Simulador académico (perfil opcional) ----------------------------
SIMULATOR_INTERVAL_SECONDS=30
SIMULATOR_SCENARIOS=ssh,ransomware,benign

# --- Reportes ----------------------------------------------------------
STORAGE_DIR=storage
REPORTS_DIR=storage/reports

# --- SLA (minutos) -----------------------------------------------------
SLA_CRITICAL_MINUTES=15
SLA_HIGH_MINUTES=30
SLA_MEDIUM_MINUTES=240
SLA_LOW_MINUTES=1440

LOG_LEVEL=INFO
