{
  "name": "SOC-Lite · Triaje académico",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "soc-lite-ingest",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f06e64db-c690-45f1-a2a2-706730bdef01",
      "name": "Webhook SIEM",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "dd9e4ffc-c9e3-4654-893f-9f0a72d8123e"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SOCLITE_API_URL + '/api/v1/alerts/ingest' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ingest-Key",
              "value": "={{ $env.SOCLITE_INGEST_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 70000
        }
      },
      "id": "f06e64db-c690-45f1-a2a2-706730bdef02",
      "name": "Ingestar alerta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "duplicate",
              "leftValue": "={{ $json.deduplicated }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f06e64db-c690-45f1-a2a2-706730bdef03",
      "name": "Duplicada",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SOCLITE_API_URL + '/api/v1/alerts/' + $json.alert_id + '/triage/automation' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ingest-Key",
              "value": "={{ $env.SOCLITE_INGEST_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "id": "f06e64db-c690-45f1-a2a2-706730bdef04",
      "name": "Ejecutar triaje",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'processed', alert_id: $('Ingestar alerta').item.json.alert_id, verdict: $json.verdict, model: $json.model, fallback_used: $json.fallback_used }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "f06e64db-c690-45f1-a2a2-706730bdef05",
      "name": "Responder procesada",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        960,
        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "f06e64db-c690-45f1-a2a2-706730bdef06",
      "name": "Responder duplicada",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        720,
        -120
      ]
    },
    {
      "parameters": {
        "content": "## SOC-Lite · laboratorio de triaje\n\nEl webhook recibe eventos simulados. La API valida, deduplica, guarda y audita; luego ejecuta el triaje. Un analista revisa el resultado y decide sobre el incidente.",
        "height": 240,
        "width": 400
      },
      "id": "f06e64db-c690-45f1-a2a2-706730bdef07",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        240
      ]
    }
  ],
  "connections": {
    "Webhook SIEM": {
      "main": [
        [
          {
            "node": "Ingestar alerta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ingestar alerta": {
      "main": [
        [
          {
            "node": "Duplicada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Duplicada": {
      "main": [
        [
          {
            "node": "Responder duplicada",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ejecutar triaje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ejecutar triaje": {
      "main": [
        [
          {
            "node": "Responder procesada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
